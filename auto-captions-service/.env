# Configuración del Servicio de Auto-Captions
HOST=0.0.0.0
PORT=8000
BASE_URL=http://localhost:8000

# Rutas de almacenamiento
STORAGE_DIR=./storage
WATCH_INPUT_DIR=./watch/input
WATCH_OUTPUT_DIR=./watch/output

# Motor ASR: 'faster-whisper' (local) o 'openai' (API remota)
ASR_ENGINE=faster-whisper
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=default

# Opcional si se usa ASR_ENGINE=openai
OPENAI_API_KEY=

# Configuración por defecto de procesamiento
DEFAULT_LANGUAGE=es
DEFAULT_TEMPLATE=hype_yellow
DEFAULT_MAX_WORDS_PER_CUE=3
DEFAULT_AUTO_EMOJI=true
DEFAULT_PAUSE_THRESHOLD_MS=450

# Worker y Cola
MAX_CONCURRENT_JOBS=2
CLEANUP_OLD_FILES_HOURS=24
